{
  "name": "laghu",
  "version": "1.1.0",
  "description": "Zero-build drop-in micro-framework: Light-DOM Web Components + Proxy reactivity + JSON-into-state fetch",
  "license": "MIT",
  "type": "module",
  "main": "dist/laghu.min.js",
  "types": "dist/laghu.d.ts",
  "unpkg": "dist/laghu.min.js",
  "jsdelivr": "dist/laghu.min.js",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "frontend",
    "micro-framework",
    "zero-build",
    "web-components",
    "reactivity",
    "light-dom",
    "csp",
    "html-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosubodh/laghu.git"
  },
  "homepage": "https://github.com/prosubodh/laghu#readme",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/size.mjs",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "playwright": "^1.64.1",
    "terser": "^5.51.2",
    "typescript": "^5.6.0",
    "vite-plus": "1.2.0",
    "vitest": "5.0.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  }
}
